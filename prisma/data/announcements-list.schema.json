{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnnouncementsList",
  "description": "JSON schema for announcements-list.json containing news and announcements items.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier of the announcement"
      },
      "type": {
        "type": "string",
        "description": "Category or type of announcement (e.g. practices, news, guest_lecture)"
      },
      "shortCut": {
        "type": "string",
        "description": "Short summary or shortcut text"
      },
      "title": {
        "type": "string",
        "description": "Title of the announcement"
      },
      "imagesList": {
        "type": "array",
        "description": "List of image URLs associated with the announcement",
        "items": {
          "type": "string"
        }
      },
      "text": {
        "type": "array",
        "description": "Paragraphs of text content",
        "items": {
          "type": "string"
        }
      },
      "component": {
        "type": "string",
        "description": "Optional raw HTML component string"
      },
      "pdfUrl": {
        "type": "string",
        "description": "Optional URL to an attached PDF document"
      },
      "date": {
        "type": "string",
        "description": "Publication date in YYYY-MM-DD format"
      },
      "linkTo": {
        "type": "string",
        "description": "Unique route link slug identifier (e.g. anno-20261022-284)"
      }
    },
    "required": [
      "id",
      "type",
      "shortCut",
      "title",
      "imagesList",
      "text",
      "component",
      "pdfUrl",
      "date",
      "linkTo"
    ],
    "additionalProperties": false
  }
}
