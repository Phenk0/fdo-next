// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model News {
  id        String     @id @default(cuid())
  slug      String?    @unique
  title     String?
  content   Json
  sourceUrl String?
  status    NewsStatus @default(DRAFT)
  tags      NewsTag[]  @default([])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

enum NewsTag {
  news
  guest_lecture
  practices
  student_science_preschool
  extracurricular
  academic_mobility
  accreditation
  student_science_physical
  entrants
  zdzn_flow
  dual
  lego
  pride
  vacancies
  war
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Department {
  KDPP
  KTMDO
  KTMFV
}

model Employee {
  id       String  @id @default(uuid())
  name     String
  slug     String  @unique
  photoUrl String?

  emails String[] @default([])
  phones String[] @default([])

  facultyProfile FacultyProfile?
  managerProfile ManagerProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FacultyProfile {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  department    Department
  jobTitle      String
  academicTitle String?

  educationInfo     String[] @default([])
  degreeInfo        String[] @default([])
  dissertationTopic String[] @default([])
  academicTitleInfo String[] @default([])
  awardsAndHonors   String[] @default([])
  supervisions      String[] @default([])

  scientificWorksPDF String?
  scientificWorksUrl String?

  professionalActivities  String?
  professionalDevelopment String[] @default([])

  certificationInfo String?
  certificates      String[] @default([])

  // Social and academic profiles
  googleAcademy String?
  orcid         String?
  WoSRID        String?
  rGate         String?
  scopusID      String?
  bibliometrics String?
  scienceUkr    String?

  // Display order
  sortOrder Int @default(0)

  @@index([department, sortOrder])
}

model ManagerProfile {
  id         String   @id @default(uuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  managerRole String
}
